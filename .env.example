# SistemaLegal - DB-first environment template
# Fecha de referencia: 2026-02-14
#
# Copie este archivo a .env y complete valores reales.
# No versionar credenciales reales.

# Runtime DB (app, nightly_audit, daily_ops)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sistemalegal

# Dedicated test DB for DB suites (must not match DATABASE_URL)
VG_TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sistemalegal_test

# Release gate mode: full | read_only
VG_RELEASE_GATE_MODE=read_only

# Optional KPI quality gate policy
# off: no evalua KPI en gate
# warn: informa desvio KPI pero no bloquea
# enforce: bloquea gate si KPI no cumple objetivo
VG_QUALITY_GATE_KPI_MODE=warn
VG_QUALITY_GATE_KPI_MIN_CASES=1

# Optional security gate policy
# off | warn | enforce
VG_SECURITY_GATE_MODE=warn
VG_DB_APP_ROLE=
VG_DB_TEST_ROLE=
VG_SECURITY_GATE_REQUIRE_TEST_ROLE_SPLIT=0

# Optional performance/capacity gate policy
# off | warn | enforce
VG_PERFORMANCE_GATE_MODE=warn
VG_PERFORMANCE_GATE_MAX_SELECT1_MS=250
VG_PERFORMANCE_GATE_MAX_CORE_COUNTS_MS=600
VG_PERFORMANCE_GATE_MAX_RECENT_DOCS_MS=800
VG_PERFORMANCE_GATE_MAX_RECENT_CASES_MS=600
VG_PERFORMANCE_GATE_MAX_DOCS_PER_CASE=300
VG_PERFORMANCE_GATE_MAX_AUDIT_ROWS=200000

# Optional operation timeouts (seconds, positive integers)
VG_SUITE_TIMEOUT_SEC=900
VG_STEP_TIMEOUT_SEC=1200

# Optional backup/restore drill settings
VG_BACKUP_DIR=
VG_BACKUP_DRILL_SCHEMA_PREFIX=restore_drill

# Optional debug
VG_DEBUG=0

# Feature flags de seguridad/app (rollout gradual)
# 0: desactivado | 1: activado
VG_AUTH_REQUIRED=1
VG_RBAC_STRICT=1
VG_AUDIT_WRITE_STRICT=0
VG_EXPORT_STRICT=1
# Auto-guardado en formularios de edicion (casos/finanzas/quick edit)
VG_AUTO_SAVE_CHANGES=1

# Auth local bootstrap/fallback (usar credenciales seguras fuera de dev)
VG_AUTH_BOOTSTRAP_USER=admin
VG_AUTH_BOOTSTRAP_PASSWORD=admin-change-now
VG_AUTH_BOOTSTRAP_ROLE=admin
VG_AUTH_PASSWORD_PEPPER=change-this-pepper
VG_AUTH_FALLBACK_USER=admin
VG_AUTH_FALLBACK_PASSWORD=admin-change-now
VG_AUTH_FALLBACK_ROLE=admin
